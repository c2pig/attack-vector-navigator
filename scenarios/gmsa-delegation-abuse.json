  "designed_by": "ai-composite",
  "description": "Targeted Kerberoast → GMSA read → RBCD → DCSync. Advanced AD with delegation and service account abuse.",
  "introduction": "This scenario teaches advanced AD abuse: GMSA password extraction, RBCD via relay or GenericWrite, and DCSync. Critical for understanding delegation chains to DA.",
  "mental_model": "GMSA stores password in msDS-ManagedPassword; read it with GenericAll/GenericWrite. RBCD lets you impersonate DA; getST + secretsdump = DCSync. Chain permissions to escalate.",
  "key_principles": [
    "GenericWrite: add SPN for targeted Kerberoast",
    "GMSA: gmsadumper extracts hash with service account",
    "RBCD: set msDS-AllowedToActOnBehalfOfOtherIdentity on DC",
    "getST -impersonate Administrator for DA ticket",
    "secretsdump -k uses Kerberos ticket for DCSync"
  ],

  "indicators": {
    "difficulty": 9,
    "cognitive_load": 9,
    "enumeration_depth": 5,
    "rabbit_hole_risk": 4,
    "time_pressure": 8
  },

