{
  "id": "sqli-to-domain-dominance",
  "title": "SQLi to Domain Dominance",
  "category": "ad-chain",
  "source": ["Medtech"],
  "designed_by": "lab-derived",
  "description": "Large AD lab: 10 machines across 2 networks. SQLi on WEB02 → xp_cmdshell → PrintSpoofer/GodPotato/SweetPotato → Mimikatz (joe:Flowers1) → credential spray → fileMonitorBackup.log (wario/yoshi:Mushroom!) → service hijack / backup.exe hijack → leon:rabbit:) domain admin → psexec sweep → DC credentials.txt (offsec) → full domain dominance.",
  "introduction": "Teaches SQLi-to-RCE via xp_cmdshell and credential chaining across many hosts. Exam-relevant: one web vuln can unlock an entire domain through password reuse and file mining.",
  "mental_model": "SQLi is your entry; xp_cmdshell is your RCE. Every file and log may contain creds—grep for NTLM, passwords, and usernames. Spray discovered creds broadly; one hit unlocks the next machine.",
  "key_principles": [
    "Enable xp_cmdshell via SQLi; use certutil to fetch and run reverse shell",
    "Mimikatz sekurlsa::logonpasswords extracts logged-on user creds",
    "Mine config files and logs for NTLM hashes; crack with hashcat",
    "Service/scheduled task hijack: replace writable binary, restart service",
    "Check DC desktop and shared folders for credentials.txt before giving up"
  ],

  "indicators": {
    "difficulty": 6,
    "cognitive_load": 6,
    "enumeration_depth": 4,
    "rabbit_hole_risk": 4,
    "time_pressure": 7
  },

