{
  "id": "kerberoast-to-domain-admin",
  "title": "Kerberoast to Domain Admin",
  "category": "exam-format",
  "source": ["OSCP B (Challenge Lab 5)"],
  "designed_by": "lab-derived",
  "description": "Exam-format scenario: 3 AD machines + 3 standalone. Given creds on AD entry → SeImpersonate → cred dump → Kerberoasting → MSSQL xp_cmdshell → Mimikatz/windows.old → Domain Admin. Standalone: SNMP+PATH hijack (Kiero), Text4Shell+JDWP (Berlin), FreeSWITCH+service hijack (Gust).",
  "introduction": "Teaches Kerberoasting as a pivot: SPN hashes crack to service accounts that often have xp_cmdshell or high privileges. Essential for when lsassy fails or you need alternate paths.",
  "mental_model": "Kerberoast early from any domain-joined host. Cracked service accounts (sql_svc, web_svc) often lead to RCE or DA. MSSQL xp_cmdshell + PrintSpoofer is a common DA path.",
  "key_principles": [
    "GetUserSPNs with domain creds; crack TGS with hashcat -m 13100",
    "MSSQL service account + xp_cmdshell = RCE as mssql$ (often SYSTEM)",
    "windows.old SAM is backup when Mimikatz fails or DA not logged on",
    "SNMP extend scripts can leak creds; PATH hijack when SUID calls unqualified binary",
    "JDWP on high port: SSH reverse tunnel to reach it, then exploit"
  ],

  "indicators": {
    "difficulty": 6,
    "cognitive_load": 5,
    "enumeration_depth": 4,
    "rabbit_hole_risk": 3,
    "time_pressure": 5
  },

  "mitre": {
    "tactics": ["TA0001","TA0003","TA0004","TA0006","TA0007","TA0008"],
    "techniques": [
      {"id":"T1021.006","name":"Windows Remote Management"},
      {"id":"T1134.001","name":"Token Impersonation/Theft"},
      {"id":"T1003.001","name":"LSASS Memory"},
      {"id":"T1003.002","name":"Security Account Manager"},
      {"id":"T1550.002","name":"Pass the Hash"},
      {"id":"T1190","name":"Exploit Public-Facing Application"},
      {"id":"T1572","name":"Protocol Tunneling"},
      {"id":"T1558.003","name":"Kerberoasting"},
      {"id":"T1059.001","name":"PowerShell"},
      {"id":"T1552.001","name":"Credentials In Files"}
    ]
  },

  "kill_chain_phases": ["T1-Recon","T2-Web-Access","T3-NonWeb-Access","T4a-Linux-PrivEsc","T4b-Win-PrivEsc","T5-Credentials","T6-Pivoting","T7-Lateral"],

  "environment": {
    "machine_count": 6,
    "network_count": 2,
    "os_distribution": {"windows": 4, "linux": 2},
    "has_ad": true,
    "has_pivoting": true,
    "has_client_side": false
  },

  "technique_tags": [
    "evil-winrm","printspoofer","godpotato","mimikatz","ligolo-ng",
    "pass-the-hash","kerberoasting","windows.old","SAM","SYSTEM","SeImpersonate",
    "xp_cmdshell","impacket-mssqlclient","impacket-GetUserSPNs","text4shell",
    "jdwp","freeswitch","snmp","nmap","hashcat","impacket-secretsdump",
    "nxc","lsassy","snmpwalk","CVE-2022-42889","CVE-2022-0847","EDB-46501",
    "EDB-47799","suid-path-hijack","service-binary-hijack","KiteService"
  ],

  "exam_relevance": {
