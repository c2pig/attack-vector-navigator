    "rvim: :set shell=/bin/bash then :shell or :!bash",
    "Python jail: __import__('os').system() or breakpoint()",
    "Escape first; linpeas/winpeas need full shell",
    "Check EDITOR env; vi often available in restricted envs"
  ],

