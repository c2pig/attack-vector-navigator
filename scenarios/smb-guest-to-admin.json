          "commands": [
            "nxc smb 10.10.10.21 -u emily.oscars -p '<password>' --shares",
            "smbclient //10.10.10.21/Users -U emily.oscars",
            {"cmd": "get 'admin\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\PSReadLine\\ConsoleHost_history.txt'", "rationale": "Why: PS history often contains passwords and commands"}
