        {"port": 3389, "name": "RDP", "version": "", "vulnerabilities": [{"type": "auth", "summary": "RDP via tunnel", "leads_to": "local-user"}], "commands": ["proxychains xfreerdp /u:admin /p:'<password>' /v:10.10.20.20"]}
