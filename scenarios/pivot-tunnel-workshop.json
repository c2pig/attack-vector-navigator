{
  "id": "pivot-tunnel-workshop",
  "title": "Pivot Tunnel Workshop",
  "category": "technique-drill",
  "source": ["All AD labs"],
  "designed_by": "ai-composite",
  "description": "Same topology, 4 attack paths: Ligolo-ng, Chisel, SSH tunnel, iox. PIVOT (Linux dual-NIC) → TARGET1, TARGET2 on internal network. Practice each tunneling method.",

  "introduction": "Pivoting is essential when targets live on internal networks—this workshop drills Ligolo-ng, Chisel, SSH, and iox so you can reach them.",
  "mental_model": "Think: shell on dual-NIC = tunnel to internal. Pick one method, get it working, then route traffic through it.",
  "key_principles": [
    "Ligolo-ng gives native routing; Chisel/SSH need proxychains",
    "Run agent on pivot, proxy on Kali",
    "Add internal CIDR to routing table after tunnel up",
    "proxychains before every internal-target command",
    "Have backup method if one fails"
  ],

  "indicators": {
    "difficulty": 5,
    "cognitive_load": 4,
    "enumeration_depth": 1,
    "rabbit_hole_risk": 1,
    "time_pressure": 3
