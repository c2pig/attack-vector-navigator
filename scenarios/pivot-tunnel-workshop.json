      "role": "Internal Target",
      "networks": ["internal"],
      "services": [
        {"port": 445, "name": "SMB", "version": "", "vulnerabilities": [{"type": "auth", "summary": "SMB via tunnel", "leads_to": "local-user"}], "commands": ["proxychains smbclient //10.10.20.10/C$ -U admin"]},
        {"port": 5985, "name": "WinRM", "version": "", "vulnerabilities": [{"type": "auth", "summary": "WinRM via tunnel", "leads_to": "local-user"}], "commands": ["proxychains evil-winrm -i 10.10.20.10 -u admin -p '<password>'"]}
      ],
