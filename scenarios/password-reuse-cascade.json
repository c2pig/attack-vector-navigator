{
  "id": "password-reuse-cascade",
  "title": "Password Reuse Cascade",
  "category": "exam-format",
  "source": ["OSCP C (Challenge Lab 6)"],
  "designed_by": "lab-derived",
  "description": "Exam-format scenario: 3 AD machines + 3 standalone. Given creds on AD entry → admintool.exe hash leak → admin → PowerShell history → password reuse spray → MS02 → lsassy/mimikatz → DA hash → DC. Standalone: Mobile Mouse RCE, SNMP→VestaCP RCE, FTP→exiftool→Usermin RCE→tar wildcard.",
  "introduction": "This scenario teaches credential reuse and lateral movement patterns common in OSCP exam. One password often unlocks multiple hosts.",
  "mental_model": "Treat every credential as a key to spray: PowerShell history, config files, and panic messages often leak passwords reused across the domain.",
  "key_principles": [
    "Always check PowerShell history for plaintext creds",
    "Password spray reused creds across internal hosts",
    "lsassy extracts DA hash from remote LSASS",
    "Ligolo-ng tunnels through dual-NIC to reach internal",
    "Tar wildcard injection hijacks cron as root"
  ],

  "indicators": {
    "difficulty": 5,
    "cognitive_load": 4,
    "enumeration_depth": 4,
    "rabbit_hole_risk": 4,
    "time_pressure": 5
  },

  "mitre": {
    "tactics": ["TA0001","TA0003","TA0004","TA0006","TA0007","TA0008"],
    "techniques": [
      {"id":"T1021.006","name":"Windows Remote Management"},
      {"id":"T1134.001","name":"Token Impersonation/Theft"},
      {"id":"T1003.001","name":"LSASS Memory"},
      {"id":"T1003.002","name":"Security Account Manager"},
      {"id":"T1550.002","name":"Pass the Hash"},
      {"id":"T1110.003","name":"Password Spraying"},
      {"id":"T1190","name":"Exploit Public-Facing Application"},
      {"id":"T1572","name":"Protocol Tunneling"},
      {"id":"T1053.005","name":"Scheduled Task/Cron"},
      {"id":"T1552.001","name":"Credentials In Files"},
      {"id":"T1087.002","name":"Domain Account"}
    ]
  },

  "kill_chain_phases": ["T1-Recon","T2-Web-Access","T3-NonWeb-Access","T4a-Linux-PrivEsc","T4b-Win-PrivEsc","T5-Credentials","T6-Pivoting","T7-Lateral"],

  "environment": {
    "machine_count": 6,
    "network_count": 2,
    "os_distribution": {"windows": 4, "linux": 2},
    "has_ad": true,
    "has_pivoting": true,
    "has_client_side": false
  },

  "technique_tags": [
    "admintool","ps-history","password-spray","mobile-mouse","vestacp","usermin","tar-wildcard",
    "snmp","exiftool","evil-winrm","godpotato","lsassy","mimikatz","ligolo-ng","iox",
    "pass-the-hash","kerberoasting","windows.old","SAM","SYSTEM","SeImpersonate",
    "nmap","feroxbuster","snmpwalk","EDB-51010","EDB-50234","hydra","hashcat",
    "pspy","cron","nxc","pypykatz","GPGService","service-binary-hijack"
  ],

  "exam_relevance": {
    "oscp_exam_format": true,
    "pen200_modules": [6,8,13,16,17,18,19,22,24],
    "pattern_frequency": "high",
    "recommended_order": 6
  },

